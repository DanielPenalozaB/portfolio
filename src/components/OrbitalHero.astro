---
import { ORBIT_RINGS } from "../data/orbits";
import { getLocaleFromUrl, useTranslations, type Locale } from "../i18n";
import OrbitItem from "./OrbitItem.astro";
import ProfileCard from "./ProfileCard.astro";
import DotGrid from "./DotGrid.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section
  id="orbital-hero"
  aria-labelledby="hero-heading"
  class="relative z-0 flex h-[800px] w-full items-center justify-center"
>
  <div class="relative z-10 flex flex-col items-center gap-12">
    <h1
      id="hero-heading"
      class="! text-4xl! font-light text-stone-800 sm:text-5xl! dark:text-stone-100"
    >
      {t("hero.greeting")}{" "}
      <span class="dm-serif-display font-semibold">{t("hero.name")}</span>
    </h1>

    <ProfileCard />

    <a
      href="/Daniel_Penaloza_CV.pdf"
      download
      aria-label={`${t("hero.download")} - Daniel Peñaloza`}
      class="group flex cursor-pointer items-center gap-2 rounded-full bg-[#52757A] p-1 pl-3.5 text-sm font-medium tracking-wider text-stone-100! transition-colors hover:bg-[#456267]!"
    >
      <span>{t("hero.download")}</span>
      <div
        class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-200 group-hover:bg-stone-100"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M12 5V19"
            stroke="#6C969D"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M19 12L12 19L5 12"
            stroke="#6C969D"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>
  </div>

  <div
    id="orbits-container"
    aria-hidden="true"
    class="pointer-events-auto absolute inset-0 z-5 flex items-center justify-center overflow-visible"
  >
    <!-- Visual Rings -->
    {
      ORBIT_RINGS.map((orbit) => (
        <div
          class="absolute rounded-full border-4 border-stone-200/50! dark:border-stone-700/50!"
          style={{
            width: `${orbit.radius * 2}px`,
            height: `${orbit.radius * 2}px`,
          }}
        />
      ))
    }

    <!-- Orbit Arms/Items -->
    {
      ORBIT_RINGS.map((orbit) => (
        <>
          {orbit.items.map((item, idx) => {
            const angle = (360 / orbit.items.length) * idx;
            return (
              <OrbitItem
                label={item.label}
                icon={item.icon}
                radius={orbit.radius}
                initialAngle={angle}
                speed={orbit.speed}
                direction={orbit.direction}
              />
            );
          })}
        </>
      ))
    }
  </div>

  <DotGrid
    dotSize={5}
    gap={15}
    baseColor="#F1F0F0"
    darkBaseColor="#1e1b18"
    activeColor="#6C969D"
    proximity={80}
    shockRadius={250}
    shockStrength={18}
    returnDuration={0.5}
  />
</section>

<style>
  #orbits-container {
    transition: transform 0.3s ease-out;
  }
  @media (max-width: 1100px) {
    #orbits-container {
      transform: scale(0.85);
    }
  }
  @media (max-width: 768px) {
    #orbits-container {
      transform: scale(0.7);
    }
  }
  @media (max-width: 480px) {
    #orbits-container {
      transform: scale(0.55);
    }
  }
</style>

<script>
  import gsap from "gsap";

  function initOrbitalHero() {
    const hero = document.getElementById("orbital-hero");
    if (!hero || hero.dataset.ready) return;
    hero.dataset.ready = "true";

    // ORBITAL ANIMATIONS
    // The orbits are CSS animations (see OrbitItem). Hovering a ring slows it down by
    // easing the playback rate of that ring's animations.
    const orbitsContainer = document.getElementById("orbits-container");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (orbitsContainer && !prefersReducedMotion) {
      const rings = new Map<
        number,
        { rate: number; animations: Animation[] }
      >();

      const getRing = (radius: number) => {
        let ring = rings.get(radius);
        if (!ring) {
          ring = { rate: 1, animations: [] };
          rings.set(radius, ring);
        }
        return ring;
      };

      // Animations are collected on first hover, so nothing runs at load.
      const collectAnimations = () => {
        if (rings.size > 0) return;
        orbitsContainer
          .querySelectorAll<HTMLElement>(".orbit-arm")
          .forEach((arm) => {
            const radius = parseFloat(arm.dataset.radius || "0");
            getRing(radius).animations.push(
              ...arm.getAnimations({ subtree: true }),
            );
          });
      };

      const setRingRate = (radius: number, rate: number) => {
        const ring = getRing(radius);
        gsap.to(ring, {
          rate,
          duration: 0.6,
          overwrite: true,
          onUpdate: () => {
            ring.animations.forEach((animation) => {
              animation.playbackRate = ring.rate;
            });
          },
        });
      };

      const hitZone = 60;
      let hovered: number | null = null;

      orbitsContainer.addEventListener("mousemove", (e) => {
        collectAnimations();
        const rect = orbitsContainer.getBoundingClientRect();
        // The container is scaled down on small screens; rect is the scaled box.
        const scale = rect.width / orbitsContainer.offsetWidth || 1;
        const dist = Math.hypot(
          e.clientX - (rect.left + rect.width / 2),
          e.clientY - (rect.top + rect.height / 2),
        );

        let next: number | null = null;
        rings.forEach((_, radius) => {
          if (Math.abs(dist - radius * scale) < hitZone * scale) next = radius;
        });

        if (next === hovered) return;
        if (hovered !== null) setRingRate(hovered, 1);
        if (next !== null) setRingRate(next, 0.1);
        hovered = next;
      });

      orbitsContainer.addEventListener("mouseleave", () => {
        if (hovered !== null) setRingRate(hovered, 1);
        hovered = null;
      });
    }

    // PROFILE CARD ANIMATIONS
    const profileContainer = document.getElementById("profile-container");
    const profileFlipper = document.getElementById("profile-flipper");

    if (profileContainer && profileFlipper) {
      let isFlipped = false;

      const flipCard = () => {
        isFlipped = !isFlipped;
        gsap.to(profileFlipper, {
          rotationY: isFlipped ? 180 : 0,
          rotateX: 0,
          duration: 0.6,
          ease: "power2.inOut",
        });
      };

      profileContainer.addEventListener("click", flipCard);
      profileContainer.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          flipCard();
        }
      });

      profileContainer.addEventListener("mousemove", (e) => {
        const rect = profileContainer.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;

        const tiltX = (y - 0.5) * -40;
        const tiltY = (x - 0.5) * 40;
        const baseY = isFlipped ? 180 : 0;

        gsap.to(profileFlipper, {
          rotateX: tiltX,
          rotationY: baseY + tiltY,
          duration: 0.3,
          ease: "power2.out",
        });
      });

      profileContainer.addEventListener("mouseleave", () => {
        const baseY = isFlipped ? 180 : 0;
        gsap.to(profileFlipper, {
          rotationY: baseY,
          rotateX: 0,
          duration: 0.6,
          ease: "power2.inOut",
        });
      });
    }
  }

  // Fires on the first load and after every client-side navigation.
  document.addEventListener("astro:page-load", initOrbitalHero);
</script>
