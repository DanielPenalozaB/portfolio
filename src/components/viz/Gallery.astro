---
/**
 * Screenshot gallery. Each shot can have a light and a dark version; the one
 * matching the site theme is shown (the hidden one is lazy and never loads).
 * Every image links to its full-size file.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Figure from "./Figure.astro";

interface Shot {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  caption?: string;
  /** Span both columns. */
  wide?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  source?: string;
  shots: Shot[];
  columns?: 1 | 2;
}

const { title, subtitle, source, shots, columns = 2 } = Astro.props;
---

<Figure title={title} subtitle={subtitle} source={source}>
  <div class={`grid grid-cols-1 gap-4 ${columns === 2 ? "sm:grid-cols-2" : ""}`}>
    {
      shots.map((s) => (
        <figure class={`flex flex-col gap-2 ${s.wide ? "sm:col-span-2" : ""}`}>
          <a
            href={s.src.src}
            target="_blank"
            rel="noopener"
            class="mx-auto block w-full overflow-hidden rounded-xl"
            style={`border:1px solid var(--viz-border);background:var(--viz-surface);max-width:${s.src.width}px`}
          >
            <Image
              src={s.src}
              alt={s.alt}
              widths={[480, 960, 1440]}
              sizes={s.wide || columns === 1 ? "(max-width: 768px) 100vw, 720px" : "(max-width: 640px) 100vw, 360px"}
              format="webp"
              quality={80}
              loading="lazy"
              class={`block h-auto w-full ${s.dark ? "dark:hidden" : ""}`}
            />
            {s.dark && (
              <Image
                src={s.dark}
                alt={s.alt}
                widths={[480, 960, 1440]}
                sizes={s.wide || columns === 1 ? "(max-width: 768px) 100vw, 720px" : "(max-width: 640px) 100vw, 360px"}
                format="webp"
                quality={80}
                loading="lazy"
                class="hidden h-auto w-full dark:block"
              />
            )}
          </a>
          {s.caption && <figcaption class="text-xs text-[color:var(--viz-text-2)]">{s.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</Figure>
