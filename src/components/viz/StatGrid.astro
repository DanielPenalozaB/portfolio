---
/**
 * KPI row of stat tiles: when the data is a handful of headline numbers, the
 * number is the chart. Values use proportional figures (no tabular-nums).
 */
interface Stat {
  value: string;
  label: string;
  note?: string;
}

interface Props {
  stats: Stat[];
  source?: string;
}

const { stats, source } = Astro.props;
const cols =
  stats.length >= 4 ? "sm:grid-cols-4" : stats.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2";
---

<div class="viz not-prose my-10">
  <dl class={`grid grid-cols-2 gap-3 ${cols}`}>
    {
      stats.map((s) => (
        <div class="viz-figure flex flex-col gap-1 rounded-2xl p-4">
          <dt class="order-2 text-sm text-[color:var(--viz-text-2)]">{s.label}</dt>
          <dd class="order-1 text-3xl font-semibold text-[color:var(--viz-text)]">{s.value}</dd>
          {s.note && <dd class="order-3 text-xs text-[color:var(--viz-text-3)]">{s.note}</dd>}
        </div>
      ))
    }
  </dl>
  {source && <p class="mt-3 text-xs text-[color:var(--viz-text-3)]">{source}</p>}
</div>
