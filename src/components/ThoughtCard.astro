---
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import { getLocaleFromUrl, type Locale } from "../i18n";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      heroImage?: import("astro").ImageMetadata;
    };
  };
}

const { post } = Astro.props;
const locale: Locale = getLocaleFromUrl(Astro.url);
---

<a
  href={`/blog/${post.id}`}
  hreflang={locale === "en" ? undefined : "en"}
  class="flex w-full flex-col items-start justify-between gap-2 p-4 transition-all duration-150 ease-out hover:bg-stone-50 sm:flex-row dark:hover:bg-stone-800/50 md:items-end md:p-6"
>
  <div
    class="flex flex-col items-start gap-2 max-md:w-full sm:flex-row sm:items-center sm:gap-8"
  >
    <div
      class="relative h-40 w-full shrink-0 overflow-hidden rounded-2xl bg-stone-200 md:w-52"
    >
      {
        post.data.heroImage && (
          <Image
            src={post.data.heroImage}
            alt={post.data.title}
            width={480}
            height={240}
            densities={[1, 2]}
            format="webp"
            quality={80}
            class="absolute inset-0 h-[inherit]! w-full object-cover"
            loading="lazy"
          />
        )
      }
    </div>
    <div class="flex flex-col gap-2.5">
      <h3 class="text-2xl! font-medium text-stone-600! md:text-3xl! dark:text-stone-200!">
        {post.data.title}
      </h3>
      <p class="m-0! line-clamp-3 text-sm text-stone-500 dark:text-stone-400">
        {post.data.description}
      </p>
    </div>
  </div>
  <span class="text-xs text-nowrap text-stone-400">
    <FormattedDate date={post.data.pubDate} />
  </span>
</a>
