---
interface Props {
  label: string;
  icon: string;
  radius: number;
  initialAngle: number;
  speed: number;
  direction: number;
}

const { label, icon, radius, initialAngle, speed, direction } = Astro.props;

// The orbit runs as a CSS animation, so the browser composites it off the main thread
// and no script has to read layout to place the items on load.
const orbitVars = {
  "--orbit-from": `${initialAngle}deg`,
  "--orbit-to": `${initialAngle + 360 * direction}deg`,
  "--orbit-duration": `${speed}s`,
};
---

<div
  class="orbit-arm absolute"
  style={{
    ...orbitVars,
    width: `${radius}px`,
    height: "0px",
    left: "50%",
    top: "50%",
    transformOrigin: "left center",
    zIndex: 20,
  }}
  data-radius={radius}
>
  <div class="absolute right-0" style={{ transform: "translate(50%, -50%)" }}>
    <div class="orbit-item-rotator">
      <div
        class="orbit-item group relative cursor-pointer transition-transform duration-200 hover:scale-110"
      >
        <div
          class="flex h-14 w-14 items-center justify-center rounded-2xl border border-gray-100 bg-white p-3 shadow-lg dark:border-stone-700 dark:bg-stone-800"
          title={label}
        >
          <img
            src={icon}
            alt={label}
            width="32"
            height="32"
            class="h-full w-full object-contain"
          />
        </div>
        <span
          class="pointer-events-none absolute -bottom-7 left-1/2 -translate-x-1/2 rounded-md bg-stone-800 px-2 py-0.5 text-xs whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100"
        >
          {label}
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .orbit-arm {
    transform: rotate(var(--orbit-from));
    animation: orbit-arm var(--orbit-duration) linear infinite;
  }
  .orbit-item-rotator {
    transform: rotate(calc(-1 * var(--orbit-from)));
    animation: orbit-counter var(--orbit-duration) linear infinite;
  }
  @keyframes orbit-arm {
    from {
      transform: rotate(var(--orbit-from));
    }
    to {
      transform: rotate(var(--orbit-to));
    }
  }
  /* Spins each item the other way so the icon stays upright. */
  @keyframes orbit-counter {
    from {
      transform: rotate(calc(-1 * var(--orbit-from)));
    }
    to {
      transform: rotate(calc(-1 * var(--orbit-to)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-arm,
    .orbit-item-rotator {
      animation: none;
    }
  }
</style>
