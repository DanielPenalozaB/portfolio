---
import { getCollection } from "astro:content";
import { getLocaleFromUrl, useTranslations, type Locale } from "../i18n";
import ThoughtCard from "./ThoughtCard.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section class="flex min-h-screen flex-col items-center px-6 py-20 sm:px-10">
  <div class="flex w-full max-w-5xl flex-col gap-12">
    <div class="reveal flex flex-col gap-4">
      <h1
        class="dm-serif-display text-4xl font-bold text-stone-800 sm:text-5xl dark:text-stone-100"
      >
        {t("blog.title")}
      </h1>
      <p class="m-0! text-lg text-stone-600 dark:text-stone-400">
        {t("thoughts.subtitle")}
        {locale !== "en" && <> {t("blog.englishOnly")}</>}
      </p>
    </div>
    <div
      class="reveal reveal-delay-1 flex w-full flex-col divide-y-2 divide-stone-300 dark:divide-stone-700"
    >
      {posts.map((post) => <ThoughtCard post={post} />)}
    </div>
  </div>
</section>
